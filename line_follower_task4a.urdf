<?xml version="1.0"?>

<robot name="line_following_bot">

 
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.20 0.30 0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.20 0.30 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.0077"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0035"
        iyz="0.0"
        izz="0.0108"/>
    </inertial>
  </link>

  
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000043"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000043"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000045"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0000045"
        iyz="0.0"
        izz="0.0000045"/>
    </inertial>
  </link>

  
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.16 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.16 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.10 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!--
  so first of all i started building the base box,the chasis for the bot.Then i started making the right wheel next the 
  left wheel then i made the joint part for both of them and made theior axis mofications propelrly as per the proper requiremt
  to be seen as a wheel attached to the chasis and wrote the parent link child link and all other things then i made the caster wheel and placed it 
  at the required position then made the caster wheel joint and in bw i added material colour.Next i added the collison and inertial part where the 
  inertial part consisted of inertia matrix where the product of inertia were present, mass and origin values i assigned then i moved to collision part
  
  -->


</robot>