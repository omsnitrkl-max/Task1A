<?xml version="1.0"?>

<robot name="line_following_bot">

  
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.20 0.30 0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.20 0.30 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.0077"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0035"
        iyz="0.0"
        izz="0.0108"/>
    </inertial>
  </link>

  
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000043"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.000043"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000043"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000045"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0000045"
        iyz="0.0"
        izz="0.0000045"/>
    </inertial>
  </link>

 
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.03 -0.15 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.03 0.15 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.12 0 -0.05" rpy="0 0 0"/>
  </joint>

  
<gazebo>
  <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.04</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

  </plugin>
</gazebo>


</robot>